<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="tcpBinding">
					<reliableSession enabled="true"/>
					<security mode="None">

					</security>
				</binding>
				<binding name="tcpReliableBinding">
					<reliableSession enabled="true" inactivityTimeout="00:00:45"/>
					<security mode="None">

					</security>
				</binding>
			</netTcpBinding>
		</bindings>
		<behaviors>
			<serviceBehaviors>
				<behavior>
					<serviceMetadata />
					<serviceDebug includeExceptionDetailInFaults="true" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
		<services>
			<service name="ServicioContrato.ImplementacionServicio">
				<endpoint address="Service" binding="netTcpBinding" bindingConfiguration="tcpBinding" contract="ServicioContrato.IGestionUsuarios" />
				<endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8000/ServiceImplementation" />
					</baseAddresses>
				</host>
			</service>
		</services>
	</system.serviceModel>
</configuration>